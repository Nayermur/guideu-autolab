# Copy this file to .env (never commit .env). On GitHub, add these as repository secrets instead.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models tried in order; if one is busy or fails, the next one is used.
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest

# Optional: Telegram approval bot (create with @BotFather; chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pause between AI calls (ms) to stay inside free-tier rate limits
LLM_DELAY_MS=4000

# Optional: Instagram auto-publishing (Phase 3). See README for how to get these.
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.facebook.com (Instagram API with Facebook Login) or graph.instagram.com (with Instagram Login)
IG_GRAPH_HOST=graph.facebook.com
IG_GRAPH_VERSION=v23.0
